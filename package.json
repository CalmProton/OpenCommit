{
  "name": "opencommit",
  "displayName": "OpenCommit",
  "description": "Free Conventional Commits generator for VS Code, powered by OpenRouter.",
  "version": "1.1.4",
  "publisher": "MadElectron",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CalmProton/OpenCommit.git"
  },
  "bugs": {
    "url": "https://github.com/CalmProton/OpenCommit/issues"
  },
  "homepage": "https://github.com/CalmProton/OpenCommit#readme",
  "packageManager": "bun@1.3.13",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "keywords": [
    "git",
    "commit",
    "source control",
    "openrouter",
    "ai"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "opencommit.generate",
        "title": "Generate",
        "category": "OpenCommit",
        "icon": "$(sparkle)"
      },
      {
        "command": "opencommit.setOpenRouterApiKey",
        "title": "Set OpenRouter API Key",
        "category": "OpenCommit"
      },
      {
        "command": "opencommit.clearOpenRouterApiKey",
        "title": "Clear OpenRouter API Key",
        "category": "OpenCommit"
      },
      {
        "command": "opencommit.planCommits",
        "title": "Plan Commits",
        "category": "OpenCommit",
        "icon": "$(list-tree)"
      },
      {
        "command": "opencommit.commitPlannedCommits",
        "title": "Commit Plan",
        "category": "OpenCommit",
        "icon": "$(check-all)"
      },
      {
        "command": "opencommit.regeneratePlan",
        "title": "Regenerate Plan",
        "category": "OpenCommit",
        "icon": "$(refresh)"
      },
      {
        "command": "opencommit.editPlannedCommitMessage",
        "title": "Edit Commit Message",
        "category": "OpenCommit",
        "icon": "$(edit)"
      },
      {
        "command": "opencommit.regeneratePlannedCommitMessage",
        "title": "Regenerate Commit Message",
        "category": "OpenCommit",
        "icon": "$(sparkle)"
      },
      {
        "command": "opencommit.movePlannedCommitFile",
        "title": "Move File to Commit",
        "category": "OpenCommit",
        "icon": "$(move)"
      },
      {
        "command": "opencommit.addPlannedCommit",
        "title": "Add Commit Group",
        "category": "OpenCommit",
        "icon": "$(add)"
      },
      {
        "command": "opencommit.removePlannedCommit",
        "title": "Remove Commit Group",
        "category": "OpenCommit",
        "icon": "$(trash)"
      }
    ],
    "views": {
      "scm": [
        {
          "id": "opencommit.plannedCommits",
          "name": "Commit Planner",
          "contextualTitle": "OpenCommit Commit Planner"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "opencommit.plannedCommits",
        "contents": "Use Commit Planner to split unstaged changes into multiple AI-generated commits.\n[Plan Commits](command:opencommit.planCommits)",
        "when": "config.git.enabled"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "opencommit.generate",
          "when": "scmProvider == git",
          "group": "navigation@9"
        }
      ],
      "scm/repository": [
        {
          "command": "opencommit.generate",
          "when": "scmProvider == git",
          "group": "inline@9"
        }
      ],
      "view/title": [
        {
          "command": "opencommit.planCommits",
          "when": "view == opencommit.plannedCommits",
          "group": "navigation@1"
        },
        {
          "command": "opencommit.commitPlannedCommits",
          "when": "view == opencommit.plannedCommits",
          "group": "navigation@2"
        },
        {
          "command": "opencommit.regeneratePlan",
          "when": "view == opencommit.plannedCommits",
          "group": "navigation@3"
        },
        {
          "command": "opencommit.addPlannedCommit",
          "when": "view == opencommit.plannedCommits",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "opencommit.editPlannedCommitMessage",
          "when": "view == opencommit.plannedCommits && viewItem == opencommit.commit",
          "group": "inline@1"
        },
        {
          "command": "opencommit.regeneratePlannedCommitMessage",
          "when": "view == opencommit.plannedCommits && viewItem == opencommit.commit",
          "group": "inline@2"
        },
        {
          "command": "opencommit.removePlannedCommit",
          "when": "view == opencommit.plannedCommits && viewItem == opencommit.commit",
          "group": "inline@3"
        },
        {
          "command": "opencommit.movePlannedCommitFile",
          "when": "view == opencommit.plannedCommits && viewItem == opencommit.file",
          "group": "inline@1"
        }
      ],
      "commandPalette": [
        {
          "command": "opencommit.generate",
          "when": "config.git.enabled"
        },
        {
          "command": "opencommit.planCommits",
          "when": "config.git.enabled"
        },
        {
          "command": "opencommit.commitPlannedCommits",
          "when": "config.git.enabled"
        },
        {
          "command": "opencommit.regeneratePlan",
          "when": "config.git.enabled"
        },
        {
          "command": "opencommit.editPlannedCommitMessage",
          "when": "config.git.enabled"
        },
        {
          "command": "opencommit.regeneratePlannedCommitMessage",
          "when": "config.git.enabled"
        },
        {
          "command": "opencommit.movePlannedCommitFile",
          "when": "config.git.enabled"
        },
        {
          "command": "opencommit.addPlannedCommit",
          "when": "config.git.enabled"
        },
        {
          "command": "opencommit.removePlannedCommit",
          "when": "config.git.enabled"
        },
        {
          "command": "opencommit.setOpenRouterApiKey"
        },
        {
          "command": "opencommit.clearOpenRouterApiKey"
        }
      ]
    },
    "configuration": {
      "title": "OpenCommit",
      "properties": {
        "opencommit.provider": {
          "type": "string",
          "scope": "resource",
          "enum": [
            "openrouter"
          ],
          "default": "openrouter",
          "description": "Provider used to generate commit messages."
        },
        "opencommit.openRouter.baseUrl": {
          "type": "string",
          "scope": "resource",
          "default": "https://openrouter.ai/api/v1",
          "description": "OpenRouter API base URL."
        },
        "opencommit.openRouter.model": {
          "type": "string",
          "scope": "resource",
          "default": "openrouter/auto",
          "description": "OpenRouter model id used for commit message generation."
        },
        "opencommit.openRouter.siteUrl": {
          "type": "string",
          "scope": "resource",
          "default": "",
          "description": "Optional HTTP-Referer header value sent to OpenRouter."
        },
        "opencommit.openRouter.appTitle": {
          "type": "string",
          "scope": "resource",
          "default": "OpenCommit VS Code Extension",
          "description": "Optional X-Title header value sent to OpenRouter."
        },
        "opencommit.format": {
          "type": "string",
          "scope": "resource",
          "enum": [
            "conventional",
            "simple",
            "custom"
          ],
          "default": "conventional",
          "description": "Commit message style. Conventional Commits is the default standard."
        },
        "opencommit.includeBody": {
          "type": "string",
          "scope": "resource",
          "enum": [
            "never",
            "auto",
            "always"
          ],
          "default": "auto",
          "description": "Whether generated commit messages should include a body."
        },
        "opencommit.customInstructions": {
          "type": "string",
          "scope": "resource",
          "default": "",
          "markdownDescription": "Additional prompt instructions. Used together with built-in rules, and especially useful when `opencommit.format` is `custom`."
        },
        "opencommit.preferStaged": {
          "type": "boolean",
          "scope": "resource",
          "default": true,
          "description": "Use staged changes when any are present; otherwise use unstaged changes."
        },
        "opencommit.maxDiffChars": {
          "type": "number",
          "scope": "resource",
          "default": 0,
          "minimum": 0,
          "maximum": 2000000,
          "markdownDescription": "Optional character cap for diff content. Set to `0` to use token budgeting from `opencommit.modelContextTokens` and `opencommit.maxPromptContextRatio`."
        },
        "opencommit.modelContextTokens": {
          "type": "number",
          "scope": "resource",
          "default": 200000,
          "minimum": 4096,
          "maximum": 2000000,
          "description": "Assumed model context window in tokens. Used for local prompt budgeting; OpenRouter metadata is not fetched automatically."
        },
        "opencommit.maxPromptContextRatio": {
          "type": "number",
          "scope": "resource",
          "default": 0.6,
          "minimum": 0.05,
          "maximum": 0.95,
          "description": "Maximum fraction of the configured model context window used for the prompt."
        },
        "opencommit.maxPromptTokens": {
          "type": "number",
          "scope": "resource",
          "default": 0,
          "minimum": 0,
          "maximum": 2000000,
          "markdownDescription": "Optional direct prompt token budget. Set to `0` to calculate it from `opencommit.modelContextTokens * opencommit.maxPromptContextRatio`."
        },
        "opencommit.language": {
          "type": "string",
          "scope": "resource",
          "default": "en",
          "description": "Language for the generated commit message."
        },
        "opencommit.temperature": {
          "type": "number",
          "scope": "resource",
          "default": 0.2,
          "minimum": 0,
          "maximum": 2,
          "description": "Sampling temperature for the provider request."
        },
        "opencommit.maxOutputTokens": {
          "type": "number",
          "scope": "resource",
          "default": 800,
          "minimum": 50,
          "maximum": 128000,
          "description": "Maximum output tokens for the generated commit message."
        },
        "opencommit.maxPlanOutputTokens": {
          "type": "number",
          "scope": "resource",
          "default": 32000,
          "minimum": 1000,
          "maximum": 128000,
          "description": "Maximum output tokens for Commit Planner JSON. Large plans need room for every planned commit and file path."
        },
        "opencommit.debugLogging": {
          "type": "boolean",
          "scope": "resource",
          "default": false,
          "description": "Write detailed prompts, diffs, redacted request metadata, raw provider responses, and final commit message cleanup details to the OpenCommit output channel."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "bun run compile && vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "typescript": "^5.6.0",
    "@vscode/vsce": "^3.2.0"
  }
}
